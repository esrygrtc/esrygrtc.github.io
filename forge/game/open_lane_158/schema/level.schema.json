{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.example/preview/open_lane_158/schema/level.schema.json",
  "title": "OPEN LANE P1 level",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "grid", "walls", "blocks", "gates", "par"],
  "properties": {
    "id": { "type": "string", "pattern": "^L[1-3]$" },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 4, "maximum": 10 },
        "h": { "type": "integer", "minimum": 4, "maximum": 12 }
      }
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/point" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "color", "symbol", "cells", "at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "color": { "$ref": "#/$defs/color" },
          "symbol": { "$ref": "#/$defs/symbol" },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/point" }
          },
          "at": { "$ref": "#/$defs/point" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "side", "span", "color", "echo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "side": { "enum": ["N", "E", "S", "W"] },
          "span": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 1 }
            ],
            "items": false
          },
          "color": { "$ref": "#/$defs/color" },
          "echo": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "cells"],
                "properties": {
                  "type": { "enum": ["RETRACT", "EXTEND"] },
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/point" }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "par": { "type": "integer", "minimum": 1, "maximum": 20 }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" }
      ],
      "items": false
    },
    "color": { "enum": ["amber", "teal", "violet", "lime"] },
    "symbol": { "enum": ["circle", "triangle", "square", "cross"] }
  }
}
